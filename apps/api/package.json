{
  "name": "@empgt/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS de la Plateforme Freelance E-MPGT.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware src test",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed:demo": "nest build && node dist/cli/seed-demo.js",
    "admin:create": "nest build && node dist/cli/create-admin.js",
    "openapi:export": "nest build && node dist/cli/export-openapi.js",
    "test:all": "vitest run",
    "import:profiles": "nest build && node dist/cli/import-profiles.js",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@empgt/contracts": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.8",
    "helmet": "8.3.0",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
