# ─────────────────────────────────────────────────────────────────────────────
# Plateforme Freelance E-MPGT : variables d'environnement
#
# Copier ce fichier en `.env` (jamais commité) puis renseigner les secrets.
# `node scripts/generate-env.mjs` crée un `.env` de développement avec des
# secrets aléatoires. Aucune valeur ci-dessous n'est un secret réel.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
# Environnement applicatif : development | staging | production.
# En production, le jeu de démonstration est refusé et les cookies sont sécurisés.
APP_ENV=development

# URL publique du frontend (liens des e-mails, contrôle d'origine CSRF).
APP_ORIGIN=http://localhost:3000

# ── Base de données PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=empgt_freelance
POSTGRES_USER=empgt
POSTGRES_PASSWORD=__A_RENSEIGNER__
# Port hôte du conteneur de développement (lié à 127.0.0.1).
POSTGRES_HOST_PORT=5440
DATABASE_URL=postgresql://empgt:__A_RENSEIGNER__@localhost:5440/empgt_freelance

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
# Secret serveur (≥ 32 caractères) : signature CSRF, empreintes. Ne jamais réutiliser entre environnements.
APP_SECRET=__A_RENSEIGNER_32_CARACTERES_MINIMUM__
# true en production (HTTPS) : cookies Secure et préfixe __Host-.
COOKIE_SECURE=false
# Durée de vie absolue d'une session et délai d'inactivité (heures).
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
# Nombre de proxys de confiance devant l'API (1 derrière Caddy).
TRUST_PROXY=0
# Documentation OpenAPI interactive (/api/docs). Désactivée par défaut en production.
OPENAPI_ENABLED=true
LOG_LEVEL=log

# ── Stockage privé des documents (compatible S3) ─────────────────────────────
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_HOST_PORT=8333
S3_REGION=us-east-1
S3_BUCKET=empgt-documents
S3_ACCESS_KEY_ID=__A_RENSEIGNER__
S3_SECRET_ACCESS_KEY=__A_RENSEIGNER__
S3_FORCE_PATH_STYLE=true
# Taille maximale d'un fichier déposé (Mo).
UPLOAD_MAX_MB=10

# ── E-mails ──────────────────────────────────────────────────────────────────
# smtp | memory (tests) | log (journalise uniquement le destinataire et le sujet)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Plateforme Freelance E-MPGT <no-reply@localhost>"
# Adresse(s) recevant les alertes d'administration (demandes de contact…), séparées par des virgules.
ADMIN_ALERT_EMAILS=
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── Import des profils historiques ───────────────────────────────────────────
# Hôtes autorisés pour la collecte côté serveur (protection SSRF).
IMPORT_ALLOWED_HOSTS=e-mpgt.com

# ── Paiements ────────────────────────────────────────────────────────────────
# Vide = suivi manuel uniquement (V1). Aucun prestataire n'est intégré à ce stade.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# ── Frontend ─────────────────────────────────────────────────────────────────
# URL de l'API vue depuis le serveur Next.js (rendu serveur et réécritures /api).
API_INTERNAL_URL=http://localhost:4000

# ── Déploiement Docker (docker/compose.yml) ──────────────────────────────────
# Adresse servie par Caddy : « :80 » en local, nom de domaine en production (HTTPS automatique).
SITE_ADDRESS=:80
HTTP_PORT=8080
