{
  "name": "@empgt/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Schémas de validation (Zod), énumérations, libellés et types d'échange partagés entre l'API et le frontend.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "oxlint": "1.88.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
